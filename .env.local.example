# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # JANGAN pernah expose ke client / NEXT_PUBLIC_

# Sesi & token undangan (multi-tenant)
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# URL aplikasi (dipakai untuk generate link undangan & metadata PWA)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary — UNSIGNED upload preset (aman untuk dipublik lewat NEXT_PUBLIC_,
# karena batasannya diatur di sisi preset-nya sendiri di Cloudinary Dashboard,
# bukan lewat API secret). Lihat README bagian "Setup Cloudinary".
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=simaset-aset-unsigned

# Cloudinary — SIGNED, server-only. Dipakai buat hapus foto lama saat
# foto aset diganti/dihapus (destroy Cloudinary wajib signed, beda dari
# upload di atas yang unsigned). Ambil dari Cloudinary Dashboard →
# halaman utama Dashboard (bukan Upload preset) → "API Key" & "API Secret".
# JANGAN pakai prefix NEXT_PUBLIC_ — ini harus rahasia.
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email developer/pemilik platform, dipisah koma kalau lebih dari satu.
# BUKAN role per-sekolah (beda dari `admin` di tabel profil) — ini akses
# lintas-tenant khusus buat approve/tolak pendaftaran sekolah baru di
# /super-admin. Orangnya WAJIB sign up dulu lewat /login (bikin akun
# Supabase Auth via undangan/reset-password manual, dsb) sebelum email-nya
# dicek ke sini — kosongkan kalau belum butuh fitur ini sama sekali.
SUPER_ADMIN_EMAILS=kamu@contoh.com
